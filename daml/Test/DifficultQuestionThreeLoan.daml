module Test.DifficultQuestionThreeLoan where

import Daml.Script
import DifficultQuestionThree.Loan
import DifficultQuestionThree.Token
import MediumQuestionTwo.LoanLimit
import DifficultQuestionThree.LoanRequest
import DifficultQuestionThree.RepaymentRestriction
import DA.Assert ((===))
import DA.Map qualified as M

data OnboardContracts = OnboardContracts with
    loanLimitCid : ContractId LoanLimit
    repaymentRestrictionCid : ContractId RepaymentRestriction
    tokenCid : IouCid
    loanRequestCid : ContractId LoanRequest

data Parties = Parties with
    bank : Party
    borrower : Party
    cb : Party

allocateParties : Script Parties
allocateParties = do
    bank <- allocateParty "Goldman Sachs"
    borrower <- allocateParty "Borrower"
    cb <- allocateParty "Central Bank"
    pure Parties{..}

setupInitialContracts : Parties -> Script OnboardContracts
setupInitialContracts Parties{..} = do
    loanLimitCid <- submit cb do
        createCmd LoanLimit with 
            bank = bank
            cb = cb
            maximumLimit = 10000.0
            borrowerLimits = M.empty

    updatedLoanLimitCid <- submit bank do
        exerciseCmd loanLimitCid UpdateLimit with
            borrower = borrower
            newLimit = 10000.0

    tokenCid <- submit bank do
        createCmd Iou with
            issuer = bank
            owner = bank
            currency = "USD"
            amount = 5000.0
            observers = []

    repaymentRestrictionCid <- submit cb do
        createCmd RepaymentRestriction with
            bank = cb
            borrower = borrower
            minRepaymentAmount = 100.0
    
    loanRequestCid <- submit borrower do
        createCmd LoanRequest with
            borrower = borrower
            bank = bank
            requestedAmount = 5000.0
            loanLimitCid = updatedLoanLimitCid
            tokenCid = tokenCid
            repaymentRestrictionCid = repaymentRestrictionCid

    pure OnboardContracts{..}

testSuccessfulDisburse : Parties -> OnboardContracts -> Script ()
testSuccessfulDisburse Parties{..} OnboardContracts{..} = do
    debug $ "Successfull: Loan found: "
    Some loanRequest <- queryContractId borrower loanRequestCid
    loanRequest.borrower === borrower
    loanRequest.bank === bank
    loanRequest.requestedAmount === 5000.0

    loanCid <- submit bank do
        exerciseCmd loanRequestCid Approve

    -- Attempt to disburse more than the remaining amount
    submitMultiMustFail [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 6000.0
    
    -- Attempt to disburse a negative amount
    submitMultiMustFail [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = -1000.0

    -- Attempt to disburse more than the borrower's limit
    submitMultiMustFail [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 11000.0

    debug $ "Successfull: before final loan" <> show loanRequestCid
    newLoanCid <- submitMulti [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 5000.0
    pure ()

    -- Some loan <- queryContractId borrower newLoanCid
    -- loan.remainingAmount === 0.0
    -- loan.approvedAmount === 5000.0
    

    -- -- repayments 
    -- repaymentLoanCid <- submit borrower do
    --     exerciseCmd newLoanCid Repay with repaymentAmount = 5000.0
    -- debug $ "Successfull: before final loan" <> show repaymentLoanCid

    -- Some repaymentLoan <- queryContractId borrower repaymentLoanCid
    -- repaymentLoan.totalRepaidAmount === 5000.0

testFailedDisburse : Parties -> OnboardContracts -> Script ()
testFailedDisburse Parties{..} OnboardContracts{..} = do
    debug $ "Loan found: " <> show loanRequestCid

    Some loan <- queryContractId borrower loanRequestCid
    debug $ "Loan found but archived already: " <> show loan
    loan.borrower === borrower
    loan.bank === bank
    -- loan.approvedAmount === 5000.0

testScript : Script ()
testScript = do
  parties <- allocateParties
  onboardContracts <- setupInitialContracts parties
  testSuccessfulDisburse parties onboardContracts
--   testFailedDisburse parties onboardContracts
  pure ()