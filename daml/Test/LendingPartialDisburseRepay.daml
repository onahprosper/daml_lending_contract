module Test.LendingPartialDisburseRepay where

import Daml.Script
import Lending.Loan
import Lending.LoanRequest
import DA.Assert ((===))
import Test.LendingSetupContracts (OnboardContracts(..), Parties(..), allocateParties, setupInitialContracts)

testPartialDisburseRepay : Parties -> OnboardContracts -> Script ()
testPartialDisburseRepay Parties{..} OnboardContracts{..} = do
    -- Query the LoanRequest contract
    Some loanRequest <- queryContractId borrower loanRequestCid
    loanRequest.borrower === borrower
    loanRequest.bank === bank
    loanRequest.requestedAmount === 5000.0

    -- Approve the loan request
    loanCid <- submit bank do
        exerciseCmd loanRequestCid Approve

    -- Partial disbursement
    newLoanCid <- submitMulti [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 2000.0

    -- Query the new Loan contract
    Some loan <- queryContractId borrower newLoanCid
    loan.amountDisbursed === 2000.0


    -- Partial disbursement
    newLoanCid2 <- submitMulti [bank, borrower] [] do
        exerciseCmd newLoanCid Disburse with disburseAmount = 2000.0

    -- Partial disbursement
    newLoanCid3 <- submitMulti [bank, borrower] [] do
        exerciseCmd newLoanCid2 Disburse with disburseAmount = 1000.0
    
    -- Partial repayment
    repaymentLoanCid1 <- submit borrower do
        exerciseCmd newLoanCid3 Repay with repaymentAmount = 1000.0

    -- Partial repayment
    repaymentLoanCid2 <- submit borrower do
        exerciseCmd repaymentLoanCid1 Repay with repaymentAmount = 2000.0

    -- Attempt to repay zero amount
    submitMustFail borrower do
        exerciseCmd repaymentLoanCid2 Repay with repaymentAmount = 0.0

  -- Attempt to repay more than the outstanding balance
    submitMustFail borrower do
        exerciseCmd repaymentLoanCid2 Repay with repaymentAmount = 6000.0
    -- Partial repayment
    repaymentLoanCid3 <- submit borrower do
        exerciseCmd repaymentLoanCid2 Repay with repaymentAmount = 2000.0

    -- Query the updated Loan contract
    Some repaymentLoan <- queryContractId borrower repaymentLoanCid3
    repaymentLoan.totalRepaidAmount === 5000.0
    repaymentLoan.remainingAmount === 0.0
    repaymentLoan.amountDisbursed === 5000.0
    debug $ "successfully tested partial disburse and repay"

    pure ()

testScript : Script ()
testScript = do
  parties <- allocateParties
  onboardContracts <- setupInitialContracts parties
  testPartialDisburseRepay parties onboardContracts
  pure ()