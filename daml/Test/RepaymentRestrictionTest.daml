module Test.RepaymentRestrictionTest where

import Daml.Script
import Lending.RepaymentRestriction

testRepaymentRestriction : Script ()
testRepaymentRestriction = do
    -- Setup parties
    bank <- allocateParty "Bank"
    borrower <- allocateParty "Borrower"

    -- Create the RepaymentRestriction contract with a minimum repayment amount of 100
    repaymentRestrictionCid <- submit bank do
        createCmd RepaymentRestriction with
            bank = bank
            borrower = borrower
            minRepaymentAmount = 100.0

    -- Borrower attempts a valid repayment of 150
    isValidRepayment <- submit bank do
        exerciseCmd repaymentRestrictionCid UpdateMinRepayment with
            newMinRepaymentAmount = 150.0
    -- Check if the repaymentRestrictionCid contract has been archived
    notNone <- queryContractId bank isValidRepayment

    -- Borrower attempts an invalid repayment of 50 (less than the minimum)
    submitMustFail borrower do
        exerciseCmd repaymentRestrictionCid UpdateMinRepayment with
            newMinRepaymentAmount = 50.0

    return ()