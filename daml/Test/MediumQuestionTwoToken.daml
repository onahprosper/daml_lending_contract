module Test.MediumQuestionTwoToken where

import Daml.Script
import MediumQuestionTwo.LoanLimit
import MediumQuestionTwo.Token
import DA.Assert ((===))
import DA.Map qualified as M

data Parties = Parties with
  bank : Party
  borrower : Party
  cb : Party

data OnboardToken =
  OnboardToken with
    loanLimitRole : ContractId LoanLimit
    updatedLoanLimitRole : ContractId LoanLimit
    tokenRole : ContractId Token
    mintedTokenRole : ContractId Token
    mintedTokenRole2 : ContractId Token

allocateParties : Script Parties
allocateParties = do
    bank <- allocateParty "Goldman Sachs"
    borrower <- allocateParty "Borrower"
    cb <- allocateParty "Central Bank"
    pure Parties{..}

testTokenMinting : Parties -> Script OnboardToken
testTokenMinting Parties{..} = do
    -- Create a LoanLimit contract
    loanLimitRole <- submit cb do
      createCmd LoanLimit with
        bank = bank
        cb = cb
        maximumLimit = 10000.0
        borrowerLimits = M.empty

    -- Check if the LoanLimit contract has been created
    Some loanLimit <- queryContractId bank loanLimitRole
    debug $ "LoanLimit found: " <> show loanLimit
    loanLimit.maximumLimit === 10000.0
    
    -- Update the LoanLimit
    updatedLoanLimitRole <- submit bank do
      exerciseCmd loanLimitRole UpdateLimit with
        borrower = borrower
        newLimit = 10000.0

    -- Create a Token contract
    tokenRole <- submit bank do
      createCmd Token with
        issuer = bank
        holder = borrower
        amount = 0.0
        loanLimitCid = updatedLoanLimitRole

    -- Check if the Token contract has been created
    Some token <- queryContractId bank tokenRole
    debug $ "Token found for bank: " <> show token
    token.amount === 0.0
    token.loanLimitCid === updatedLoanLimitRole
  
    -- Check if the Token contract has been created
    Some borrowerShow <- queryContractId borrower tokenRole
    debug $ "Token found for borrower: " <> show token
    borrowerShow.amount === 0.0
    borrowerShow.loanLimitCid === updatedLoanLimitRole
    
    -- Mint tokens by the issuer and holder
    mintedTokenRole <- submitMulti [bank, borrower] [] do
      exerciseCmd tokenRole Mint with
        additionalAmount = 3000.0

    -- Check if the Token contract has been minted correctly
    Some mintedToken <- queryContractId borrower mintedTokenRole
    debug $ "Minted Token found for borrower: " <> show mintedToken
    mintedToken.amount === 3000.0

    -- Mint tokens by the holder
    mintedTokenRole2 <- submitMulti [bank, borrower] [] do
      exerciseCmd mintedTokenRole Mint with
        additionalAmount = 2000.0

    -- Check if the Token contract has been minted correctly
    Some mintedToken2 <- queryContractId borrower mintedTokenRole2
    debug $ "Minted Token 2 found: " <> show mintedToken2
    mintedToken2.amount === 5000.0

    -- Attempt to mint tokens exceeding the borrower's limit
    submitMustFail borrower do
      exerciseCmd mintedTokenRole2 Mint with
        additionalAmount = 1000.0  -- This exceeds the borrower's limit of 5000.0

    -- Attempt to mint tokens with an additional amount of 0.0
    submitMustFail bank do
      exerciseCmd tokenRole Mint with
        additionalAmount = 0.0  -- This should fail as the amount is not positive

    -- Attempt to mint tokens with an additional amount less than 0.0
    submitMustFail bank do
      exerciseCmd tokenRole Mint with
        additionalAmount = -100.0  -- This should fail as the amount is not positive

    pure OnboardToken{..}
testScript : Script ()
testScript = do
  parties <- allocateParties
  onboardToken <- testTokenMinting parties
  pure ()