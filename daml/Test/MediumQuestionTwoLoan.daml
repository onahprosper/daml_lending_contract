module Test.MediumQuestionTwoLoan where

import Daml.Script
import MediumQuestionTwo.LoanLimit
import MediumQuestionTwo.Token
import MediumQuestionTwo.Loan
import DA.Assert ((===))
import DA.Map qualified as M

data OnboardContracts = OnboardContracts with
  loanLimitRole : ContractId LoanLimit
  updatedLoanLimitRole : ContractId LoanLimit
  tokenRole : ContractId Token
  loanCid : ContractId Loan

data Parties = Parties with
  bank : Party
  borrower : Party
  cb : Party

allocateParties : Script Parties
allocateParties = do
  bank <- allocateParty "Goldman Sachs"
  borrower <- allocateParty "Borrower"
  cb <- allocateParty "Central Bank"
  pure Parties{..}

setupInitialContracts : Parties -> Script OnboardContracts
setupInitialContracts Parties{..} = do
    loanLimitRole <- submit cb do
        createCmd LoanLimit with 
            bank = bank
            cb = cb
            maximumLimit = 10000.0
            borrowerLimits = M.empty

    updatedLoanLimitRole <- submit bank do
        exerciseCmd loanLimitRole UpdateLimit with
            borrower = borrower
            newLimit = 10000.0

    tokenRole <- submit bank do
        createCmd Token with
            issuer = bank
            holder = borrower
            amount = 0.0
            loanLimitCid = updatedLoanLimitRole

    loanCid <- submit borrower do
        createCmd Loan with
            borrower = borrower
            bank = bank
            approvedAmount = 5000.0
            remainingAmount = 5000.0
            loanLimitCid = updatedLoanLimitRole
            tokenCid = tokenRole

    pure OnboardContracts{..}

testSuccessfulDisburse : Parties -> OnboardContracts -> Script ()
testSuccessfulDisburse Parties{..} OnboardContracts{..} = do
    newLoanCid <- submitMulti [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 3000.0

    Some loan <- queryContractId borrower newLoanCid
    loan.remainingAmount === 2000.0
    loan.approvedAmount === 5000.0

    Some token <- queryContractId borrower loan.tokenCid
    token.amount === 3000.0

    finalLoanCid <- submitMulti [bank, borrower] [] do
        exerciseCmd newLoanCid Disburse with disburseAmount = 2000.0

    Some finalLoan <- queryContractId borrower finalLoanCid
    finalLoan.remainingAmount === 0.0

    Some finalToken <- queryContractId borrower finalLoan.tokenCid
    finalToken.amount === 5000.0

testFailedDisburse : Parties -> OnboardContracts -> Script ()
testFailedDisburse Parties{..} OnboardContracts{..} = do
    submitMultiMustFail [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 6000.0

    -- Attempt to disburse a negative amount
    submitMultiMustFail [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = -1000.0

    -- Attempt to disburse more than the borrower's limit
    submitMultiMustFail [bank, borrower] [] do
        exerciseCmd loanCid Disburse with disburseAmount = 11000.0

testScript : Script ()
testScript = do
  parties <- allocateParties
  onboardContracts <- setupInitialContracts parties
  testSuccessfulDisburse parties onboardContracts
  testFailedDisburse parties onboardContracts
  pure ()