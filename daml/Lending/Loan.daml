module Lending.Loan where

import DA.Map qualified as M
import Lending.LoanLimit
import Lending.Token (IouCid, splitOff, transferHolding, creditHolding)
import Lending.RepaymentRestriction

template Loan
  with
    borrower : Party
    bank : Party
    approvedAmount : Decimal
    amountDisbursed : Decimal
    remainingAmount : Decimal
    totalRepaidAmount : Decimal
    loanLimitCid : ContractId LoanLimit
    -- Cash still held by the bank. None once the issued holding is fully disbursed.
    bankHoldingCid : Optional IouCid
    -- Cash the borrower currently holds. None before the first disbursement
    -- and again once that cash has been fully repaid.
    borrowerHoldingCid : Optional IouCid
    repaymentRestrictionCid : ContractId RepaymentRestriction
  where
    signatory borrower, bank
    observer bank

    ensure remainingAmount <= approvedAmount 

    choice Disburse : ContractId Loan
        with
            disburseAmount : Decimal
        controller bank, borrower
        do
        assertMsg "Disburse amount must be positive" (disburseAmount > 0.0)

        loanLimit <- fetch loanLimitCid
        let borrowerLimit = M.lookup borrower loanLimit.borrowerLimits
        let bankLimit = loanLimit.maximumLimit

        case borrowerLimit of
            None -> error "Borrower limit not found"
            Some limit -> do
            let nextSumAmount = amountDisbursed + disburseAmount
            let totalDisbursed = approvedAmount - nextSumAmount

            -- total must be > 0
            assertMsg "Total disbursed amount would exceed borrower's limit" (nextSumAmount <= limit)
            assertMsg "Total disbursed amount would exceed bank's limit" (nextSumAmount <= bankLimit)
            assertMsg "Total disbursed amount exceeds approved amount" (totalDisbursed >= 0.0)

            bankCid <- case bankHoldingCid of
              None -> error "Bank has no holding left to disburse"
              Some cid -> pure cid
            -- Move only `disburseAmount`. The bank keeps the remainder.
            (pieceCid, bankRest) <- splitOff bankCid disburseAmount
            movedCid <- transferHolding pieceCid borrower
            newBorrowerCid <- creditHolding borrowerHoldingCid movedCid
            held <- fetch newBorrowerCid
            assertMsg "Disbursed cash must be owned by the borrower" (held.owner == borrower)
            assertMsg "Borrower holding must equal principal still outstanding"
              (held.amount == nextSumAmount - totalRepaidAmount)

            create this with
                amountDisbursed = nextSumAmount
                bankHoldingCid = bankRest
                borrowerHoldingCid = Some newBorrowerCid

    choice Repay : ContractId Loan
      with
        repaymentAmount : Decimal
      controller borrower
      do
        assertMsg "Repayment amount must be positive" (repaymentAmount > 0.0)

        let sumOfAmountRepaid = totalRepaidAmount + repaymentAmount
        assertMsg "Repayment amount exceeds remaining amount" (sumOfAmountRepaid <= approvedAmount)
        restriction <- fetch repaymentRestrictionCid
        let minRepaymentAmount = restriction.minRepaymentAmount

        assertMsg "Repayment does not meet minimum requirement" (repaymentAmount >= minRepaymentAmount)
        let remainingAmount = approvedAmount - sumOfAmountRepaid -- remaining amount after repayment can be negative
        assertMsg "Remaining amount cannot be negative" (remainingAmount >= 0.0)

        borrowerCid <- case borrowerHoldingCid of
          None -> error "Borrower has no holding to repay"
          Some cid -> pure cid
        -- Move only `repaymentAmount` back to the bank and merge it into
        -- the bank's remaining holding. A zero-amount holding is not left behind.
        (pieceCid, borrowerRest) <- splitOff borrowerCid repaymentAmount
        movedCid <- transferHolding pieceCid bank
        newBankCid <- creditHolding bankHoldingCid movedCid
        bankHeld <- fetch newBankCid
        assertMsg "Repaid cash must be owned by the bank" (bankHeld.owner == bank)
        case borrowerRest of
          None ->
            assertMsg "A full repayment must clear the borrower holding"
              (amountDisbursed == sumOfAmountRepaid)
          Some restCid -> do
            rest <- fetch restCid
            assertMsg "Outstanding cash must stay with the borrower" (rest.owner == borrower)
            assertMsg "Borrower holding must equal principal still outstanding"
              (rest.amount == amountDisbursed - sumOfAmountRepaid)

        create this with
            totalRepaidAmount = sumOfAmountRepaid
            remainingAmount = remainingAmount
            borrowerHoldingCid = borrowerRest
            bankHoldingCid = Some newBankCid


    choice CloseAndUpdateUtilizedAmount : ()
        with
            amountChange : Decimal
        controller bank
        do
            assertMsg "Amount change must be positive" (amountChange > 0.0)
            assertMsg "Amount change exceeds remaining amount" (amountChange <= totalRepaidAmount)
            _ <- exercise loanLimitCid UpdateUtilizedAmount with amountChange = amountChange
            archive self