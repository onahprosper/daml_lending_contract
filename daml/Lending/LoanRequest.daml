module Lending.LoanRequest where

import Lending.LoanLimit
import Lending.Token (IouCid)
import Lending.Loan
import Lending.RepaymentRestriction

template LoanRequest
  with
    borrower : Party
    bank : Party
    requestedAmount : Decimal
    loanLimitCid : ContractId LoanLimit
    tokenCid : IouCid
    repaymentRestrictionCid : ContractId RepaymentRestriction
  where
    signatory borrower
    observer bank

    choice Approve : ContractId Loan
      controller bank
      do
        loanLimit <- fetch loanLimitCid
        assertMsg "Requested amount exceeds bank's limit" (requestedAmount <= loanLimit.maximumLimit)
        iou <- fetch tokenCid
        assertMsg "Loan cash must be issued and held by the bank"
          (iou.issuer == bank && iou.owner == bank)
        assertMsg "Bank holding does not cover the requested amount"
          (iou.amount >= requestedAmount)
        create Loan with
          borrower = borrower
          bank = bank
          approvedAmount = requestedAmount
          amountDisbursed = 0.0
          remainingAmount = 0.0
          totalRepaidAmount = 0.0
          loanLimitCid = loanLimitCid
          bankHoldingCid = Some tokenCid
          borrowerHoldingCid = None
          repaymentRestrictionCid = repaymentRestrictionCid