-- An Iou is a holding: `amount` is the quantity `owner` has a claim on.
-- Split and Merge conserve that quantity. Transfer moves a whole holding,
-- so a partial payment has to split the exact amount off first.
-- BEGIN_IOU_MODULE_NAME
module Lending.Token where
-- END_IOU_MODULE_NAME

type IouCid = ContractId Iou

-- BEGIN_IOU_TEMPLATE_DATATYPE
template Iou
  with
    issuer : Party
    owner : Party
    currency : Text
    amount : Decimal
    observers : [Party]
-- END_IOU_TEMPLATE_DATATYPE
  where
-- BEGIN_IOU_TEMPLATE_CONDITIONS
    ensure amount > 0.0
    signatory issuer, owner
-- END_IOU_TEMPLATE_CONDITIONS
-- BEGIN_IOU_TEMPLATE_OBSERVERS
    observer observers
-- END_IOU_TEMPLATE_OBSERVERS

      -- Split the IOU by dividing the amount.
-- BEGIN_IOU_TEMPLATE_SPLIT
    choice Iou_Split : (IouCid, IouCid)
        with
        splitAmount: Decimal
      controller owner
      do
        assertMsg "Split amount must be positive and leave a remainder"
          (splitAmount > 0.0 && splitAmount < amount)
        let restAmount = amount - splitAmount
        splitCid <- create this with amount = splitAmount
        debug $ "Splitting IOU: " <> show splitAmount <> " to " <> show restAmount
        restCid <- create this with amount = restAmount
        return (splitCid, restCid)
    
-- END_IOU_TEMPLATE_SPLIT

      -- Merge two IOUs by aggregating their amounts.
-- BEGIN_IOU_TEMPLATE_MERGE
    choice Iou_Merge : IouCid
      with
        otherCid: IouCid
      controller owner
      do
        otherIou <- fetch otherCid
        -- Check the two IOU's are compatible
        assert (
          currency == otherIou.currency &&
          owner == otherIou.owner &&
          issuer == otherIou.issuer
          )
        -- Retire the old Iou
        archive otherCid
        -- Return the merged Iou
        create this with amount = amount + otherIou.amount
-- END_IOU_TEMPLATE_MERGE

-- BEGIN_IOU_TEMPLATE_TRANSFER
    choice Iou_Transfer : ContractId IouTransfer
      with
        newOwner : Party
      controller owner
      do create IouTransfer with iou = this; newOwner
-- END_IOU_TEMPLATE_TRANSFER

-- BEGIN_IOU_TEMPLATE_OBSERVER_CHOICES
    choice Iou_AddObserver : IouCid
      with
        newObserver : Party
      controller owner
      do create this with observers = newObserver :: observers

    choice Iou_RemoveObserver : IouCid
      with
        oldObserver : Party
      controller owner
      do create this with observers = filter (/= oldObserver) observers
-- END_IOU_TEMPLATE_OBSERVER_CHOICES

template IouTransfer
  with
    iou : Iou
    newOwner : Party
  where
    signatory iou.issuer, iou.owner
    observer newOwner

    choice IouTransfer_Cancel : IouCid
      controller iou.owner
      do create iou

    choice IouTransfer_Reject : IouCid
      controller newOwner
      do create iou

    choice IouTransfer_Accept : IouCid
      controller newOwner
      do
        -- Keep the previous owner as an observer. Daml 3 does not let a
        -- party fetch a contract they only witnessed, and incremental
        -- repay needs the borrower to see the Iou after it returns to the bank.
        let nextObservers = filter (/= newOwner) (iou.owner :: iou.observers)
        create iou with
          owner = newOwner
          observers = nextObservers

-- Take `qty` out of a holding. Returns the piece of size `qty` and the
-- remainder still owned by the current owner. The remainder is None when
-- `qty` is the whole holding, because a zero-amount Iou cannot exist.
splitOff : IouCid -> Decimal -> Update (IouCid, Optional IouCid)
splitOff cid qty = do
  iou <- fetch cid
  assertMsg "Quantity must be positive" (qty > 0.0)
  assertMsg "Quantity exceeds the holding" (qty <= iou.amount)
  if qty == iou.amount
    then pure (cid, None)
    else do
      (pieceCid, restCid) <- exercise cid Iou_Split with splitAmount = qty
      pure (pieceCid, Some restCid)

-- Move a whole holding to `newOwner`. The amount does not change.
transferHolding : IouCid -> Party -> Update IouCid
transferHolding cid newOwner = do
  proposalCid <- exercise cid Iou_Transfer with newOwner = newOwner
  exercise proposalCid IouTransfer_Accept

-- Add `incoming` to a holding already owned by the same party.
-- With no existing holding, `incoming` is the position.
creditHolding : Optional IouCid -> IouCid -> Update IouCid
creditHolding existing incoming = case existing of
  None -> pure incoming
  Some cid -> exercise cid Iou_Merge with otherCid = incoming
